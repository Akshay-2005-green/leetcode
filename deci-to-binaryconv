#include <iostream>
using namespace std;
int main() {
    int decinum;
    cin >> decinum;
    int ans = 0;
    int pow = 1;
    while(decinum > 0){
        int rem = decinum % 2;
        decinum = decinum/2;
        ans = rem*pow + ans;
        pow = pow*10;
    }
    cout << ans << endl;

    return 0;
}


